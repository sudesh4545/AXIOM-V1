# AXIOM V1 — web app environment
#
# Yeh file **template** hai aur git mein commit hoti hai. Actual values
# `.env.local` mein daalein — woh gitignored hai.
#
# `NEXT_PUBLIC_` prefix zaroori hai: Next.js sirf isi prefix wale variables
# browser bundle mein bhejta hai. Iska matlab yeh bhi hai ki inme **kabhi**
# secret na daalein — yeh publicly visible hote hain.

# Optional legacy FastAPI base URL (trailing slash ke bina).
# Blank chhodne par hosted/local Site apni same-origin persistent API use karegi.
NEXT_PUBLIC_AXIOM_API_URL=
