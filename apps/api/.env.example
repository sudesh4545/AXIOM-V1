# AXIOM API environment
#
# Isko `.env` mein copy karein aur values fill karein. `.env` gitignored hai.
# Sab variables `AXIOM_` prefix use karte hain taaki shared host pe doosre
# process ke variables se collide na karein.

# --- Application ---
AXIOM_ENVIRONMENT=local
AXIOM_DEBUG=true

# --- Database ---
# Local default (koi install nahi chahiye):
AXIOM_DATABASE_URL=sqlite+aiosqlite:///./axiom_local.db
#
# Postgres pe switch karne ke liye sirf yeh line badlein aur
# `pip install asyncpg` karein. Baaki koi code change nahi:
# AXIOM_DATABASE_URL=postgresql+asyncpg://axiom:password@localhost:5432/axiom
#
# Har SQL statement log karna hai (debugging ke liye, bahut verbose):
AXIOM_DATABASE_ECHO=false

# --- CORS ---
# Comma-separated. Frontend ka origin yahan hona chahiye warna browser
# request block karega.
AXIOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Ingestion ---
AXIOM_MAX_EVENTS_PER_REQUEST=500
